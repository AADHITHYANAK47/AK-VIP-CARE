# ==============================================================================
# CareerLens AI - Enterprise Configuration & Custom Database Setup
# ==============================================================================

# 1. DATABASE CONFIGURATION (Supply your own database!)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Session Pooler):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Default local SQLite (Fallback):
# DATABASE_URL=sqlite:///./careerlens.db

# Example: Neon Serverless PostgreSQL
# DATABASE_URL=postgresql://username:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Example: MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/careerlens

# 2. EMAIL OTP AUTHENTICATION & SMTP (Production Email Delivery)
# ------------------------------------------------------------------------------
# If SMTP is left empty, CareerLens will print OTPs to the server console and 
# provide an instant development autofill toast so you can test smoothly!
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=CareerLens Security <noreply@careerlens.ai>
SMTP_USE_TLS=true

# 3. AI CHATBOT & COPILOT API KEYS (Optional)
# ------------------------------------------------------------------------------
# If no key is provided, CareerLens uses its built-in offline expert career engine.
# Supplying any of these unlocks real-time LLM streaming:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. SYSTEM SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=careerlens-enterprise-secret-key-2026-sha256
