# ==============================================================================
# CareerLens AI - Backend Configuration
# ==============================================================================

# Database
DATABASE_URL=sqlite:///./careerlens.db

# Gmail SMTP Real Delivery Configuration
# To send real verification OTPs to unique Gmail inboxes:
# 1. Go to your Google Account (myaccount.google.com) -> Security
# 2. Enable 2-Step Verification
# 3. Create an "App Password" (select app: Other, name: CareerLens)
# 4. Paste the 16-character password into SMTP_PASSWORD below:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=CareerLens India <your.email@gmail.com>
SMTP_USE_TLS=true

# AI Copilot Keys (Optional)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security
SECRET_KEY=careerlens-enterprise-secret-key-2026-sha256
